# ---------------------------------------------------------------------------
# Demo profile — `npm run demo`.
#
# Boots the whole product with NO external dependencies: an in-process
# Postgres (PGlite) that migrates and seeds itself on start, and the mock model
# provider so the assistant works offline and free.
#
# The secrets below are deliberately fake and committed on purpose; they are
# development-only values for a throwaway in-memory database. Production
# refuses to start with placeholder secrets — see apps/api/src/config/env.ts.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# `memory://` selects the in-process database. Anything else is a real DSN.
DATABASE_URL=memory://demo
DATABASE_SSL=false

JWT_SECRET=demo-only-jwt-secret-not-for-production-use
PASSWORD_PEPPER=demo-only-password-pepper-not-for-prod

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./var/storage

AI_PROVIDER=mock
