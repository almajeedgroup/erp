# ---------------------------------------------------------------------------
# Al-Majeed ERP — example environment.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Every variable below is validated at boot by apps/api/src/config/env.ts.
# See docs/03-security/secrets-management.md for how these are handled in prod.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug
API_HOST=0.0.0.0
API_PORT=4000
# Public origin of the web app; used for CORS and cookie domain decisions.
WEB_ORIGIN=http://localhost:3000

# --- Database --------------------------------------------------------------
# Postgres 17 with the `vector` extension (see docker-compose.yml).
DATABASE_URL=postgresql://erp:erp@localhost:5432/erp
DATABASE_POOL_MAX=10
# Require TLS to the database in every non-local environment.
DATABASE_SSL=false

# --- Authentication --------------------------------------------------------
# 32+ random bytes, base64. Generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
JWT_ISSUER=almajeed-erp
JWT_AUDIENCE=almajeed-erp-api
ACCESS_TOKEN_TTL=900          # seconds (15 minutes)
REFRESH_TOKEN_TTL=2592000     # seconds (30 days)
# Pepper mixed into password hashing. Rotating this invalidates all passwords.
PASSWORD_PEPPER=CHANGE_ME_generate_with_openssl_rand_base64_32

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_MAX=300            # requests per window, per IP+principal
RATE_LIMIT_WINDOW=60000       # window in ms

# --- Document storage ------------------------------------------------------
# driver: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./var/storage
STORAGE_MAX_UPLOAD_BYTES=26214400   # 25 MiB
# Only needed when STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- AI ---------------------------------------------------------------------
# provider: mock | anthropic   (`mock` keeps dev and CI deterministic + free)
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
AI_MAX_OUTPUT_TOKENS=2048
AI_EMBEDDING_DIMENSIONS=1536
# Hard ceiling on agent tool-calling loops; protects against runaway spend.
AI_MAX_AGENT_STEPS=8

# --- Web app (apps/web) ----------------------------------------------------
NEXT_PUBLIC_APP_NAME=Al-Majeed ERP
# Server-side base URL the Next.js route handlers use to reach the API.
API_BASE_URL=http://localhost:4000
