{
  "name": "@almajeed/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Al-Majeed ERP HTTP API (Fastify).",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "seed": "tsx --env-file-if-exists=../../.env src/scripts/seed.ts",
    "dev:demo": "tsx watch --env-file=../../.env.demo src/index.ts"
  },
  "dependencies": {
    "@almajeed/db": "*",
    "@almajeed/shared": "*",
    "@anthropic-ai/sdk": "^0.125.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@node-rs/argon2": "^2.2.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.4",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.12",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "pino-pretty": "^13.2.0"
  }
}
