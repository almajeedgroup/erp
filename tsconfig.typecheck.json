{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": false,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@almajeed/shared": ["./packages/shared/src/index.ts"],
      "@almajeed/db": ["./packages/db/src/index.ts"],
      "@almajeed/db/testing": ["./packages/db/src/testing.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "apps/api/src/**/*.ts",
    "packages/db/drizzle.config.ts",
    "vitest.config.ts"
  ]
}
